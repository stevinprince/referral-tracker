# Server
PORT=8080
ENVIRONMENT=development

# Database
DATABASE_URL=postgres://user:password@localhost:5432/referral_tracker?sslmode=disable

# Auth
APP_USERNAME=admin
APP_PASSWORD_HASH=$2a$12$examplehashhere

# Session
SESSION_DURATION=24h

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Extraction
FETCH_TIMEOUT=10s
FETCH_MAX_SIZE=5242880
FETCH_MAX_REDIRECTS=3
